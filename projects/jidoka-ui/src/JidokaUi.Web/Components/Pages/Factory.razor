@page "/factory"
@using JidokaUi.Core.Beads
@using JidokaUi.Core.Boards
@using JidokaUi.Core.Factory
@using JidokaUi.Core.Jidoka
@using JidokaUi.Core.Projects
@inject FactoryReader Reader
@inject BacklogCache Backlogs
@inject ProjectWatchers Watchers
@inject JidokaAdapter Jidoka
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>Factory</PageTitle>

<h1>Factory</h1>

<p class="text-muted">Every epic that the factory holds, in all of your projects, with the lap of each task.</p>

@if (view is null)
{
    <p>The app is reading the epics of your projects…</p>
}
else
{
    @foreach (var unread in view.Projects.Where(project => project.IsUnread))
    {
        <p class="failure-message">
            <strong>@unread.Project.DirectoryName</strong>, @unread.Reason
        </p>
    }

    @if (view.IsEmpty)
    {
        <p class="text-muted">The factory holds no epic.</p>
    }

    @foreach (var project in view.Projects.Where(project => project.Epics.Count > 0))
    {
        <h2>
            @project.Project.DirectoryName
            <span class="text-muted machine-text factory-path">@project.Project.Value</span>
        </h2>

        @foreach (var held in project.Epics)
        {
            <section class="factory-epic">
                <h3 class="h5">
                    <a href="@BeadPageAddress.Of(new BeadAddress(project.Project, held.Epic.Id))">@held.Epic.Title</a>
                    <BeadId Id="@held.Epic.Id" Quiet="true" />
                </h3>

                <FactoryDrive States="StatesOf(project.Project)"
                              Project="project.Project"
                              EpicId="@held.Epic.Id"
                              OnStopped="() => ReadStatesOneRunAtATimeAsync(project)" />

                @if (held.Tasks.Count == 0)
                {
                    <p class="text-muted">This epic holds no task.</p>
                }
                else
                {
                    <FactoryTaskTable Project="project.Project" Tasks="held.Tasks" />
                }
            </section>
        }
    }
}

@code {
    /// <summary>
    /// How often the page asks for the factory states again. A host that closes, a watcher that
    /// exits and a heartbeat that goes stale change no bead, so no change of the backlog tells the
    /// page that an epic stopped driving.
    /// </summary>
    public static readonly TimeSpan StateRefresh = TimeSpan.FromSeconds(30);

    private FactoryView? view;
    private readonly Dictionary<ProjectPath, Read<IReadOnlyList<EpicFactoryState>>> states = [];
    private ITimer? refresh;
    private readonly HashSet<ProjectPath> readingStates = [];
    private readonly Dictionary<ProjectPath, FactoryProject> statesToReadNext = [];

    protected override async Task OnInitializedAsync()
    {
        Backlogs.Changed += OnBacklogChanged;
        view = await Reader.ReadAsync();
        foreach (var project in view.Projects)
        {
            Watchers.Watch(project.Project);
        }

        await Task.WhenAll(view.Projects.Select(ReadStatesOneRunAtATimeAsync));
        refresh = Clock.CreateTimer(_ => _ = InvokeAsync(RefreshStatesAsync), null, StateRefresh, StateRefresh);
    }

    public void Dispose()
    {
        Backlogs.Changed -= OnBacklogChanged;
        refresh?.Dispose();
    }

    private async Task RefreshStatesAsync()
    {
        if (view is null)
        {
            return;
        }

        await Task.WhenAll(view.Projects.Select(ReadStatesOneRunAtATimeAsync));
        StateHasChanged();
    }

    private Read<IReadOnlyList<EpicFactoryState>>? StatesOf(ProjectPath project) =>
        states.GetValueOrDefault(project);

    private void OnBacklogChanged(BacklogChange change) => _ = InvokeAsync(() => Reread(change.Project));

    private async Task Reread(ProjectPath project)
    {
        if (view is null)
        {
            return;
        }

        var read = await Reader.ReadAsync(project);
        view = view.With(read);
        StateHasChanged();
        await ReadStatesOneRunAtATimeAsync(read);
        StateHasChanged();
    }

    private async Task ReadStatesOneRunAtATimeAsync(FactoryProject read)
    {
        if (!readingStates.Add(read.Project))
        {
            statesToReadNext[read.Project] = read;
            return;
        }

        try
        {
            var next = read;
            do
            {
                await ReadStatesOnceAsync(next);
            }
            while (statesToReadNext.Remove(read.Project, out next));
        }
        finally
        {
            readingStates.Remove(read.Project);
        }
    }

    private async Task ReadStatesOnceAsync(FactoryProject read)
    {
        if (read.Epics.Count == 0)
        {
            states.Remove(read.Project);
            return;
        }

        states[read.Project] = await Jidoka.FactoryStatesAsync(read.Project);
    }
}
