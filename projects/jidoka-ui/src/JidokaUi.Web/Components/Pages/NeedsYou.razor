@page "/needs-you"
@using JidokaUi.Core.Beads
@using JidokaUi.Core.Boards
@using JidokaUi.Core.Jidoka
@using JidokaUi.Core.Look
@using JidokaUi.Core.Projects
@inject NeedsYouReader Reader
@inject BacklogCache Backlogs
@inject ProjectCatalog Catalog
@inject BeadOpener Opener
@implements IDisposable

<PageTitle>Needs you</PageTitle>

<h1>Needs you</h1>

<p class="text-muted">Every bead that waits on you, in all of your projects.</p>

@if (view is null)
{
    <p>The app is reading the beads of your projects…</p>
}
else
{
    @if (gone.Length > 0)
    {
        <p class="failure-message">@gone</p>
    }

    <NewTabRefusal Feedback="newTab" />

    @foreach (var unread in view.Projects.Where(project => project.IsUnread))
    {
        <p class="failure-message">
            <strong>@unread.Project.DirectoryName</strong> — @unread.Reason
        </p>
    }

    @if (view.IsEmpty)
    {
        <p class="text-muted">No bead waits on you.</p>
    }

    @foreach (var project in view.Projects.Where(project => project.Beads.Count > 0))
    {
        <h2>
            @project.Project.DirectoryName
            <span class="text-muted machine-text needs-you-path">@project.Project.Value</span>
        </h2>

        <table class="table table-sm table-hover align-middle needs-you-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Project</th>
                    <th>Id</th>
                    <th>Type</th>
                    <th>Priority</th>
                    <th>Labels</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bead in project.Beads)
                {
                    var address = new BeadAddress(project.Project, bead.Id);
                    <PressableRow Class="needs-you-row" Style="@null" OnOpen="up => Open(address, up)">
                        <td class="needs-you-title-cell">
                            <RowTitle Class="needs-you-title btn btn-link p-0 align-baseline"
                                      Address="@BeadPageAddress.Of(address)"
                                      Tooltip="@null"
                                      Text="@bead.Title" />
                        </td>
                        <td class="needs-you-project-cell"><span class="machine-text needs-you-project-chip pill-chip">@project.Project.DirectoryName</span></td>
                        <td class="needs-you-fact"><BeadId Id="@bead.Id" Quiet="true" /></td>
                        <td class="needs-you-fact">@bead.Type</td>
                        <td class="needs-you-fact">@(bead.HasPriority ? $"p{bead.PriorityText}" : "—")</td>
                        <td class="needs-you-fact">
                            @foreach (var label in bead.Labels)
                            {
                                <span class="badge text-bg-light me-1">@label</span>
                            }
                        </td>
                    </PressableRow>
                    @if (JidokaParts.Of(bead).Question is { } question)
                    {
                        <tr class="needs-you-answer">
                            <td class="needs-you-answer-cell" colspan="6">
                                <AnswerPanel @key="address" Address="address" Question="question" MovedOn="false" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

@code {
    private NeedsYouView? view;
    private string gone = string.Empty;
    private readonly NewTabFeedback newTab = new();

    protected override async Task OnInitializedAsync()
    {
        Backlogs.Changed += OnBacklogChanged;
        view = await Reader.ReadAsync();
    }

    public void Dispose() => Backlogs.Changed -= OnBacklogChanged;

    private void OnBacklogChanged(BacklogChange change) => _ = InvokeAsync(() => Reread(change.Project));

    private async Task Reread(ProjectPath project)
    {
        if (view is null)
        {
            return;
        }

        view = view.With(await Reader.ReadAsync(project));
        StateHasChanged();
    }

    private async Task Open(BeadAddress bead, MouseEventArgs release)
    {
        var destination = BeadDestination.Of(Catalog, bead);
        if (!destination.Reaches)
        {
            gone = destination.Message;
            newTab.Take(NewTabOutcome.None);
            view = await Reader.ReadAsync();
            return;
        }

        newTab.Take(await Opener.OpenAsync(destination.Path, release));
    }
}
