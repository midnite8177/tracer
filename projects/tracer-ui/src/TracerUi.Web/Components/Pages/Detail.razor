@page "/bead/{Id}"
@using TracerUi.Core.Beads
@using TracerUi.Core.Boards
@using TracerUi.Core.Projects
@using AReadOfTheBacklog = TracerUi.Core.Boards.Read<TracerUi.Core.Boards.BacklogFacts>
@using AReadOfTheBead = TracerUi.Core.Boards.Read<TracerUi.Core.Boards.BeadDetail>
@inject BeadDetailReader Details
@inject BacklogCache Backlogs
@inject ProjectWatchers Watchers
@inject ActiveProjectSelection Selection
@inject SwitchAddress Switches
@inject NavigationManager Navigation
@inherits ProjectPage
@implements IDisposable

<PageTitle>@TheTitleOfThisPage</PageTitle>

@if (TheProject.Addressed is AddressedProject.Lost lostProject)
{
    <BeadHead Id="" Project="null"><Title><h1>@Id</h1></Title></BeadHead>
    <p class="text-danger bead-message">@lostProject.Reason</p>
}
else if (TheProject.Addressed is AddressedProject.Unnamed)
{
    <BeadHead Id="" Project="null" />
    <p>@NoActiveProject.Ask A bead belongs to the active project.</p>
    <a class="btn btn-primary" href="">Go to the projects</a>
}
else if (read is null)
{
    <BeadHead Id="" Project="TheProjectOnTheScreen" />
    <p>The app is reading this bead…</p>
}
else if (read.Detail is AReadOfTheBead.Unread unreadBead)
{
    <BeadHead Id="" Project="TheProjectOnTheScreen"><Title><h1>@Id</h1></Title></BeadHead>
    <p class="text-danger bead-message">@unreadBead.Reason</p>
}
else if (read.Detail is AReadOfTheBead.Given { Value: var detail } && TheProjectOnTheScreen is { } project)
{
    var bead = new BeadAddress(project, detail.Bead.Id);
    var facts = detail.BacklogFacts;

    <BeadHead Id="@detail.Bead.Id" Project="project">
        <Title>
            <BeadTitleEdit Address="bead" Bead="detail.Bead" OnWritten="ReadForThePerson" />
        </Title>
    </BeadHead>

    @if (facts is AReadOfTheBacklog.Unread unreadBacklog)
    {
        <p class="text-danger bead-message bead-unread-backlog">
            bd gave no backlog, so this page says nothing of the epic that holds this bead,
            the beads it holds, what blocks it or what it blocks.
            @unreadBacklog.Reason
        </p>
    }

    @if (fromBefore is { } before)
    {
        <p class="text-danger bead-message bead-stale-read">
            @before.Why<br />
            @before.What
        </p>
    }

    <ReReadMark Rereading="reads.Rereading">
        <div class="bead-columns">
            @* Without the key, a walk to another bead keeps the rows, and an open picker carries its unsaved ticks onto that bead. *@
            <BeadFactStrip @key="bead"
                           Address="bead"
                           Detail="detail"
                           Epics="read.Epics"
                           Labels="read.Labels"
                           OnWritten="ReadForThePerson" />

            <div class="bead-prose-column">
                @if (detail.Bead.HasCloseReason)
                {
                    <section class="bead-box bead-close-reason">
                        <h2 class="h4 bead-section">Closed</h2>
                        <p>@detail.Bead.CloseReason</p>
                    </section>
                }

                <section class="bead-box">
                    <BeadDescriptionEdit Address="bead"
                                         Bead="detail.Bead"
                                         OnWritten="ReadForThePerson" />
                </section>

                @if (facts is AReadOfTheBacklog.Given { Value: var answered })
                {
                    @if (answered.Held.Count > 0)
                    {
                        <section class="bead-box">
                            <BeadHeldBeads Held="answered.Held" Address="bead" Detail="detail" OnCreated="ReadForThePerson" />
                        </section>
                    }
                    else if (!answered.NamesNoBead)
                    {
                        <BeadAbsentLine Words="This bead holds no bead.">
                            <Presses>
                                <BeadHeldCreate Address="bead" Detail="detail" OnCreated="ReadForThePerson" />
                            </Presses>
                        </BeadAbsentLine>
                    }

                    <BeadDependencyEdges Address="bead"
                                         Facts="answered"
                                         Beads="read.Beads"
                                         OnWritten="ReadForThePerson">
                        <HeldPress>
                            <BeadHeldCreate Address="bead" Detail="detail" OnCreated="ReadForThePerson" />
                        </HeldPress>
                    </BeadDependencyEdges>
                }

                <BeadAcceptanceAndNotes Address="bead"
                                        Bead="detail.Bead"
                                        OnWritten="ReadForThePerson" />

                <section class="bead-box">
                    <BeadComments Address="bead"
                                  Detail="detail"
                                  OnWritten="ReadForThePerson" />
                </section>
            </div>
        </div>
    </ReReadMark>
}

@code {
    /// <summary>The id of the bead that the page shows, as the router hands it from the address.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private BeadDetailRead? read;
    private PageProject? theProject;
    private IDisposable? switchWalk;
    private BeadAddress? theBeadRead;
    private FromBefore? fromBefore;
    private readonly ReadSequence reads = new();
    private bool watcherReading;
    private bool watcherReadAgain;

    private const string TheBeadIsFromBefore = "The bead on the screen is the one from before.";
    private const string TheBacklogIsFromBefore = "The backlog on the screen is the one from before.";

    // Why the page shows what an earlier read gave, and which part of the page that is.
    private sealed record FromBefore(string Why, string What);

    // A read whose backlog bd would not give, with the backlog on the screen in its place, and the
    // reason bd gave.
    private sealed record BacklogFromBefore(BeadDetailRead Read, string Why);

    private string TheTitleOfThisPage =>
        read?.Detail is AReadOfTheBead.Given { Value: var detail } ? detail.Bead.Title : Id;

    // Built once, at first use, because Blazor injects the services it takes after the constructor runs.
    private PageProject TheProject =>
        theProject ??= new PageProject(
            Navigation, Selection, BeadPageAddress.Page, "that holds this bead", TheAddressOfThisBeadIn);

    private ProjectPath? TheProjectOnTheScreen => TheProject.OnTheScreen;

    protected override void OnInitialized()
    {
        FollowTheBacklog(Backlogs, TheProject, TakeTheChange);
        // The id of a bead names nothing outside the project that holds it, so a switch walks to the
        // board of the picked project instead of to this id in it.
        switchWalk = Switches.WalkTo(BoardFilterAddress.OfEverythingIn);
    }

    private string TheAddressOfThisBeadIn(ProjectPath project) => BeadPageAddress.Of(new BeadAddress(project, Id));

    public void Dispose()
    {
        StopFollowingTheBacklog();
        switchWalk?.Dispose();
    }

    // A change that a write of the app raised reads nothing: the page that wrote reads the bead again
    // itself, and the project watcher reports the same write to every page.
    private Task TakeTheChange(BacklogChange change) =>
        change.Kind is BacklogChangeKind.Watch ? ReadForTheProjectWatcher() : Task.CompletedTask;

    // A change that arrives while a read of the project watcher runs waits for it, and then the page
    // reads once, so a burst of changes costs two reads and not one for each change.
    private async Task ReadForTheProjectWatcher()
    {
        if (watcherReading)
        {
            watcherReadAgain = true;
            return;
        }

        watcherReading = true;
        try
        {
            do
            {
                watcherReadAgain = false;
                await Read(ReadCause.TheProjectWatcher);
                StateHasChanged();
            }
            while (watcherReadAgain);
        }
        finally
        {
            watcherReading = false;
        }
    }

    // Reads the bead when the address names a bead other than the one the page last began to read:
    // another id, or the same id in another project. The rewrite of an address that names no
    // project takes the address a second time, and that take finds the bead it began to read.
    // An address that names no project the page can read clears the page, and no answer to an
    // earlier read lands on it.
    protected override async Task ShowTheAddressAsync()
    {
        if (TheProject.TakeTheAddressOf(Id) is AddressChange.Elsewhere)
        {
            return;
        }

        if (TheProjectOnTheScreen is not { } project)
        {
            theBeadRead = null;
            read = null;
            return;
        }

        Watchers.Watch(project);
        var bead = new BeadAddress(project, Id);
        if (bead.Equals(theBeadRead))
        {
            return;
        }

        theBeadRead = bead;
        await ReadTheBead();
    }

    // Reads this bead from the start. The page drops what it showed and says that it reads, until
    // this read answers or a read of the project watcher that began after it lands first.
    private async Task ReadTheBead()
    {
        read = null;
        fromBefore = null;
        StateHasChanged();
        await ReadForThePerson();
        StateHasChanged();
    }

    private Task ReadForThePerson() => Read(ReadCause.ThePerson);

    // A failed read keeps the bead only when bd gave up or no person asked for the read, because
    // the bead on the screen is then a better answer than the failure. See ADR 0015 and the Re-read
    // entry of GLOSSARY.md.
    private string? WhyTheBeadStays(BeadDetailRead fresh, ReadCause cause)
    {
        if (fresh.Detail is not AReadOfTheBead.Unread { Reason: var reason })
        {
            return null;
        }

        if (read?.Detail is not AReadOfTheBead.Given)
        {
            return null;
        }

        if (fresh.GaveUp)
        {
            return NoAnswerAgain;
        }

        return cause is ReadCause.TheProjectWatcher ? reason : null;
    }

    // A read of the project watcher that got the bead and no backlog takes the bead and keeps the
    // backlog on the screen, because no person asked for the read and the pickers still offer the
    // epics and the labels of that backlog.
    private BacklogFromBefore? TheBacklogThatStays(BeadDetailRead fresh, ReadCause cause)
    {
        if (cause is not ReadCause.TheProjectWatcher)
        {
            return null;
        }

        if (fresh.Detail is not AReadOfTheBead.Given { Value: var detail }
            || detail.BacklogFacts is not AReadOfTheBacklog.Unread { Reason: var reason })
        {
            return null;
        }

        if (read is not { Detail: AReadOfTheBead.Given { Value.BacklogFacts: AReadOfTheBacklog.Given facts } } shown)
        {
            return null;
        }

        var kept = detail with { Status = shown.Backlog.StatusOf(detail.Bead), BacklogFacts = facts };
        return new BacklogFromBefore(
            fresh with { Detail = new AReadOfTheBead.Given(kept), Backlog = shown.Backlog },
            reason);
    }

    private async Task Read(ReadCause cause)
    {
        if (TheProjectOnTheScreen is not { } project)
        {
            return;
        }

        var bead = new BeadAddress(project, Id);
        var thisRead = reads.Begin(cause, read is not null);
        if (cause is ReadCause.ThePerson && reads.Rereading)
        {
            StateHasChanged();
        }

        BeadDetailRead fresh;
        try
        {
            fresh = await Details.ReadAsync(project, Id);
        }
        finally
        {
            reads.End(thisRead);
        }

        if (!bead.Equals(theBeadRead) || !reads.CanLand(thisRead))
        {
            return;
        }

        if (WhyTheBeadStays(fresh, cause) is { } why)
        {
            fromBefore = new FromBefore(why, TheBeadIsFromBefore);
            return;
        }

        if (TheBacklogThatStays(fresh, cause) is { } kept)
        {
            fromBefore = new FromBefore(kept.Why, TheBacklogIsFromBefore);
            Land(kept.Read, thisRead);
            return;
        }

        if (reads.IsTheLatest(thisRead))
        {
            fromBefore = null;
        }

        Land(fresh, thisRead);
    }

    private void Land(BeadDetailRead answer, int thisRead)
    {
        reads.Land(thisRead);
        read = answer;
    }
}
