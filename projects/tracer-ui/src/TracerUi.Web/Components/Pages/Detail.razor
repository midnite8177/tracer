@page "/bead/{Id}"
@using TracerUi.Core.Beads
@using TracerUi.Core.Boards
@using TracerUi.Core.Projects
@using AReadOfTheBacklog = TracerUi.Core.Boards.Read<TracerUi.Core.Boards.BacklogFacts>
@using AReadOfTheBead = TracerUi.Core.Boards.Read<TracerUi.Core.Boards.BeadDetail>
@inject BeadDetailReader Details
@inject ActiveProjectSelection Selection
@inject SwitchAddress Switches
@inject NavigationManager Navigation
@inherits ProjectPage
@implements IDisposable

<PageTitle>@TheTitleOfThisPage</PageTitle>

@if (TheProject.Addressed is AddressedProject.Lost lostProject)
{
    <BeadHead Id="" Project="null"><Title><h1>@Id</h1></Title></BeadHead>
    <p class="text-danger bead-message">@lostProject.Reason</p>
}
else if (TheProject.Addressed is AddressedProject.Unnamed)
{
    <BeadHead Id="" Project="null" />
    <p>@NoActiveProject.Ask A bead belongs to the active project.</p>
    <a class="btn btn-primary" href="">Go to the projects</a>
}
else if (read is null)
{
    <BeadHead Id="" Project="TheProjectOnTheScreen" />
    <p>The app is reading this bead…</p>
}
else if (read.Detail is AReadOfTheBead.Unread unreadBead)
{
    <BeadHead Id="" Project="TheProjectOnTheScreen"><Title><h1>@Id</h1></Title></BeadHead>
    <p class="text-danger bead-message">@unreadBead.Reason</p>
}
else if (read.Detail is AReadOfTheBead.Given { Value: var detail } && TheProjectOnTheScreen is { } project)
{
    var bead = new BeadAddress(project, detail.Bead.Id);
    var facts = detail.BacklogFacts;

    <BeadHead Id="@detail.Bead.Id" Project="project">
        <Title>
            <BeadTitleEdit Address="bead" Bead="detail.Bead" OnWritten="Reload" />
        </Title>
    </BeadHead>

    @if (facts is AReadOfTheBacklog.Unread unreadBacklog)
    {
        <p class="text-danger bead-message bead-unread-backlog">
            bd gave no backlog, so this page says nothing of the epic that holds this bead,
            the beads it holds, what blocks it or what it blocks.
            @unreadBacklog.Reason
        </p>
    }

    @if (staleReadMessage.Length > 0)
    {
        <p class="text-danger bead-message bead-stale-read">@staleReadMessage</p>
    }

    <ReReadMark Rereading="rereading">
        <div class="bead-columns">
            <BeadFactStrip Address="bead"
                           Detail="detail"
                           Epics="read.Epics"
                           Labels="read.Labels"
                           OnWritten="Reload" />

            <div class="bead-prose-column">
                @if (detail.Bead.HasCloseReason)
                {
                    <section class="bead-box bead-close-reason">
                        <h2 class="h4 bead-section">Closed</h2>
                        <p>@detail.Bead.CloseReason</p>
                    </section>
                }

                <section class="bead-box">
                    <BeadDescriptionEdit Address="bead"
                                         Bead="detail.Bead"
                                         OnWritten="Reload" />
                </section>

                @if (facts is AReadOfTheBacklog.Given { Value: var answered })
                {
                    @if (answered.Held.Count > 0)
                    {
                        <section class="bead-box">
                            <BeadHeldBeads Held="answered.Held" Address="bead" Detail="detail" OnCreated="Reload" />
                        </section>
                    }
                    else if (!answered.NamesNoBead)
                    {
                        <BeadAbsentLine Words="This bead holds no bead.">
                            <Presses>
                                <BeadHeldCreate Address="bead" Detail="detail" OnCreated="Reload" />
                            </Presses>
                        </BeadAbsentLine>
                    }

                    <BeadDependencyEdges Address="bead"
                                         Facts="answered"
                                         Beads="read.Beads"
                                         OnWritten="Reload">
                        <HeldPress>
                            <BeadHeldCreate Address="bead" Detail="detail" OnCreated="Reload" />
                        </HeldPress>
                    </BeadDependencyEdges>
                }

                <BeadAcceptanceAndNotes Address="bead"
                                        Bead="detail.Bead"
                                        OnWritten="Reload" />

                <section class="bead-box">
                    <BeadComments Address="bead"
                                  Detail="detail"
                                  OnWritten="Reload" />
                </section>
            </div>
        </div>
    </ReReadMark>
}

@code {
    /// <summary>The id of the bead that the page shows, as the router hands it from the address.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private BeadDetailRead? read;
    private PageProject? theProject;
    private IDisposable? switchWalk;
    private BeadAddress? theBeadRead;
    private bool rereading;
    private string staleReadMessage = string.Empty;

    private int readsBegun;
    private int theLatestReadShown;

    private const string StaleReadMessage =
        "bd has not answered again. The bead on the screen is the one from before.";

    private string TheTitleOfThisPage =>
        read?.Detail is AReadOfTheBead.Given { Value: var detail } ? detail.Bead.Title : Id;

    // Built once, at first use, because Blazor injects the services it takes after the constructor runs.
    private PageProject TheProject =>
        theProject ??= new PageProject(
            Navigation, Selection, BeadPageAddress.Page, "that holds this bead", TheAddressOfThisBeadIn);

    private ProjectPath? TheProjectOnTheScreen => TheProject.OnTheScreen;

    protected override void OnInitialized()
    {
        // The id of a bead names nothing outside the project that holds it, so a switch walks to the
        // board of the picked project instead of to this id in it.
        switchWalk = Switches.WalkTo(BoardFilterAddress.OfEverythingIn);
    }

    private string TheAddressOfThisBeadIn(ProjectPath project) => BeadPageAddress.Of(new BeadAddress(project, Id));

    public void Dispose() => switchWalk?.Dispose();

    // Reads the bead when the address names a bead other than the one the page last began to read:
    // another id, or the same id in another project. The rewrite of an address that names no
    // project takes the address a second time, and that take finds the bead it began to read.
    // An address that names no project the page can read clears the page, and no answer to an
    // earlier read lands on it.
    protected override async Task ShowTheAddressAsync()
    {
        if (TheProject.TakeTheAddressOf(Id) is AddressChange.Elsewhere)
        {
            return;
        }

        if (TheProjectOnTheScreen is not { } project)
        {
            theBeadRead = null;
            read = null;
            return;
        }

        var bead = new BeadAddress(project, Id);
        if (bead.Equals(theBeadRead))
        {
            return;
        }

        theBeadRead = bead;
        await ReadTheBead();
    }

    // Reads this bead from the start. The page holds no read while bd answers, so it says
    // that it reads.
    private async Task ReadTheBead()
    {
        read = null;
        staleReadMessage = string.Empty;
        StateHasChanged();
        await Reload();
        StateHasChanged();
    }

    private int BeginARead() => ++readsBegun;

    private bool IsTheLatest(int aRead) => aRead == readsBegun;

    private async Task Reload()
    {
        if (TheProjectOnTheScreen is not { } project)
        {
            return;
        }

        var bead = new BeadAddress(project, Id);
        var thisRead = BeginARead();
        rereading = read is not null;
        if (rereading)
        {
            StateHasChanged();
        }

        BeadDetailRead fresh;
        try
        {
            fresh = await Details.ReadAsync(project, Id);
        }
        finally
        {
            if (IsTheLatest(thisRead))
            {
                rereading = false;
            }
        }

        // An answer lands only on the bead it was asked for, and never over the answer of a read
        // that began after it. The re-read mark stays until the latest read answers.
        if (!bead.Equals(theBeadRead) || thisRead < theLatestReadShown)
        {
            return;
        }

        // A re-read that gave up on bd has nothing new to show. The bead on the screen is one
        // write old, same as it is through any re-read, so the page keeps it and says so instead
        // of clearing itself to an error.
        if (fresh.GaveUp && read?.Detail is AReadOfTheBead.Given)
        {
            staleReadMessage = StaleReadMessage;
            return;
        }

        if (IsTheLatest(thisRead))
        {
            staleReadMessage = string.Empty;
        }

        theLatestReadShown = thisRead;
        read = fresh;
    }
}
