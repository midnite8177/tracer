@page "/bead/{Id}"
@using TracerUi.Core.Beads
@using TracerUi.Core.Boards
@using TracerUi.Core.Projects
@using AReadOfTheBacklog = TracerUi.Core.Boards.Read<TracerUi.Core.Boards.BacklogFacts>
@using AReadOfTheBead = TracerUi.Core.Boards.Read<TracerUi.Core.Boards.BeadDetail>
@inject BeadDetailReader Details
@inject ActiveProjectSelection Selection
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@TheTitleOfThisPage</PageTitle>

@if (lost.Length > 0)
{
    <BeadHead Id=""><Title><h1>@Id</h1></Title></BeadHead>
    <p class="text-danger bead-message">@lost</p>
}
else if (Selection.Current is null)
{
    <BeadHead Id="" />
    <p>@NoActiveProject.Ask A bead belongs to the active project.</p>
    <a class="btn btn-primary" href="">Go to the projects</a>
}
else if (read is null)
{
    <BeadHead Id="" />
    <p>The app is reading this bead…</p>
}
else if (read.Detail is AReadOfTheBead.Unread unreadBead)
{
    <BeadHead Id=""><Title><h1>@Id</h1></Title></BeadHead>
    <p class="text-danger bead-message">@unreadBead.Reason</p>
}
else if (read.Detail is AReadOfTheBead.Given { Value: var detail } && readProject is { } project)
{
    var bead = new BeadAddress(project, detail.Bead.Id);
    var facts = detail.BacklogFacts;

    <BeadHead Id="@detail.Bead.Id">
        <Title>
            <BeadTitleEdit Address="bead" Bead="detail.Bead" OnWritten="Reload" />
        </Title>
    </BeadHead>

    @if (facts is AReadOfTheBacklog.Unread unreadBacklog)
    {
        <p class="text-danger bead-message bead-unread-backlog">
            bd gave no backlog, so this page says nothing of the epic that holds this bead,
            the beads it holds, what blocks it or what it blocks.
            @unreadBacklog.Reason
        </p>
    }

    <div class="bead-columns">
        <BeadFactStrip Address="bead"
                       Detail="detail"
                       Epics="read.Epics"
                       Labels="read.Labels"
                       OnWritten="Reload" />

        <div class="bead-prose-column">
            @if (detail.Bead.HasCloseReason)
            {
                <section class="bead-box bead-close-reason">
                    <h2 class="h4 bead-section">Closed</h2>
                    <p>@detail.Bead.CloseReason</p>
                </section>
            }

            <section class="bead-box">
                <BeadDescriptionEdit Address="bead"
                                     Bead="detail.Bead"
                                     OnWritten="Reload" />
            </section>

            @if (facts is AReadOfTheBacklog.Given { Value: var answered })
            {
                @if (answered.Held.Count > 0)
                {
                    <section class="bead-box">
                        <BeadHeldBeads Held="answered.Held" Address="bead" OnCreated="Reload" />
                    </section>
                }
                else if (!answered.NamesNoBead)
                {
                    <BeadAbsentLine Words="This bead holds no bead.">
                        <Presses>
                            <BeadHeldCreate Address="bead" OnCreated="Reload" />
                        </Presses>
                    </BeadAbsentLine>
                }

                <BeadDependencyEdges Address="bead"
                                     Facts="answered"
                                     Beads="read.Beads"
                                     OnWritten="Reload">
                    <HeldPress>
                        <BeadHeldCreate Address="bead" OnCreated="Reload" />
                    </HeldPress>
                </BeadDependencyEdges>
            }

            <BeadAcceptanceAndNotes Address="bead"
                                    Bead="detail.Bead"
                                    OnWritten="Reload" />

            <section class="bead-box">
                <BeadComments Address="bead"
                              Detail="detail"
                              OnWritten="Reload" />
            </section>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private BeadDetailRead? read;
    private ProjectPath? readProject;
    private string lost = string.Empty;

    // The title of the bead, which the browser tab carries. A page that has read no bead yet, or
    // that read none at all, names it by the id that the address gave.
    private string TheTitleOfThisPage =>
        read?.Detail is AReadOfTheBead.Given { Value: var detail } ? detail.Bead.Title : Id;

    protected override void OnInitialized()
    {
        SelectTheProjectThatTheAddressNames();
        Selection.Changed += OnActiveProjectChanged;
    }

    // Makes the project that the address names the active one, before this page listens for a
    // switch. A tab that the browser opened beside another one carries no active project of its
    // own, so the address is where it learns which repository holds this bead.
    private void SelectTheProjectThatTheAddressNames()
    {
        if (BeadPageAddress.ProjectIn(Navigation.Uri) is not { } project)
        {
            return;
        }

        if (!Selection.Select(project))
        {
            lost = $"{project.DirectoryName} is not in the registry any more, "
                + "so this address names no project that holds this bead.";
        }
    }

    private void OnActiveProjectChanged(ActiveProjectChange change)
    {
        if (change.Kind is ActiveProjectChangeKind.Switch)
        {
            // The id of a bead names nothing outside the project that holds it, so a person who
            // switched stands on the board of the new project instead of on a bead of the old one.
            _ = InvokeAsync(() => Navigation.NavigateTo("board"));
            return;
        }

        if (lost.Length > 0)
        {
            return;
        }

        // A restore names no other project, and this tab opened this bead, so the page reads it
        // again instead of leaving for a board.
        _ = InvokeAsync(ReadTheBead);
    }

    public void Dispose() => Selection.Changed -= OnActiveProjectChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (lost.Length > 0 || Selection.Current is null)
        {
            return;
        }

        await ReadTheBead();
    }

    // Reads this bead from the start. The page holds no read while bd answers, so it says
    // that it reads, wherever the read began.
    private async Task ReadTheBead()
    {
        read = null;
        StateHasChanged();
        await Reload();
        StateHasChanged();
    }

    // Reads the bead again, so that the page shows what bd holds after a write.
    private async Task Reload()
    {
        if (Selection.Current is null)
        {
            return;
        }

        readProject = Selection.Current;
        read = await Details.ReadAsync(readProject, Id);
    }
}
