@page "/board"
@using Microsoft.AspNetCore.Components.Routing
@using TracerUi.Core.Boards
@using TracerUi.Core.Look
@using TracerUi.Core.Projects
@using TheBoard = TracerUi.Core.Boards.Board
@inject NavigationManager Navigation
@inject BacklogCache Backlogs
@inject ProjectWatchers Watchers
@inject ActiveProjectSelection Selection
@inject SavedFilterCatalog SavedFilters
@inject BeadOpener Opener
@implements IDisposable

<PageTitle>Board</PageTitle>

<h1>Board</h1>

@if (Selection.Current is null)
{
    <p>@NoActiveProject.Ask The board shows the beads of the active project.</p>
    <a class="btn btn-primary" href="">Go to the projects</a>
}
else if (outcome is null)
{
    <p>The app is reading the beads of this project…</p>
}
else if (!outcome.Answered)
{
    <p class="text-muted">@Selection.Current.Value</p>
    <p class="text-danger board-message">@outcome.Message</p>
}
else
{
    <p class="text-muted">@Selection.Current.Value</p>

    <NewTabRefusal Feedback="newTab" />

    <FilterBar Filter="filter"
               FilterChanged="OnFilterChanged"
               Types="types"
               Priorities="priorities"
               Labels="labels"
               Epics="epics"
               Saved="savedFilters"
               OnSave="SaveTheFilter"
               OnForget="Forget" />

    <QuickCreate Project="Selection.Current"
                 Epics="epics" />

    <BulkBar Project="Selection.Current"
             Selected="SelectedBeads"
             Labels="labels"
             Epics="epics"
             OnCleared="ClearTheSelection"
             OnRetry="KeepOnlyTheseBeads" />

    @if (board.IsEmpty)
    {
        <p>No bead of this project matches the filter and the toggles.</p>
    }
    else
    {
        <table class="table board-table">
            <thead>
                <tr>
                    <th class="board-cell-tick"></th>
                    @foreach (var column in Columns)
                    {
                        <th>@column</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in collapsed.Draws(board.Rows))
                {
                    @Row(row)
                }

                @if (board.Unparented.Count > 0)
                {
                    <tr class="board-row board-unparented">
                        <td class="board-cell-tick" style="--row-depth: @TheBoard.UnparentedDepth">
                            <div class="board-ticks">
                                @BranchTick(UnparentedIds, "Select every bead under this row")
                            </div>
                        </td>
                        <td class="board-cell-title" colspan="@Columns.Length">
                            <div class="board-title-line">
                                @CollapseControl(collapsed.HoldsUnparented, collapsed.ToggleUnparented)
                                <span>@TheBoard.UnparentedTitle</span>
                                @Count(board.UnparentedHeld)
                            </div>
                        </td>
                    </tr>
                    @foreach (var row in collapsed.DrawsUnparented(board.Unparented))
                    {
                        @Row(row)
                    }
                }
            </tbody>
        </table>
    }
}

@code {
    // The columns that follow the tick, in the order that the table draws them. The Unparented row
    // spans all of them, so one list gives the header its cells and that row its width.
    private static readonly string[] Columns = ["Title", "Id", "Type", "Priority", "Labels", "Status", "Demo"];

    // One row of the board. The tree and the beads under the Unparented row take the same drawing,
    // so a bead of either place reads the same, and the depth alone says where it sits.
    private RenderFragment Row(BoardRow row) =>
        @<PressableRow Class="board-row" Style="@($"--row-depth: {row.Depth}")"
                       OnOpen="up => Open(row.Bead.Id, up)">
            <td class="board-cell-tick" @onclick:stopPropagation="true">
                <div class="board-ticks">
                    <input class="form-check-input" type="checkbox"
                           title="Select this bead"
                           checked="@selection.Holds(row.Bead.Id)"
                           @onchange="() => ToggleTheBead(row.Bead.Id)" />
                    @if (row.Branch.Count > 1)
                    {
                        @BranchTick(row.Branch, "Select this bead and every bead below it")
                    }
                </div>
            </td>
            <td class="board-cell-title">
                <div class="board-title-line">
                    @if (row.Held > 0)
                    {
                        @CollapseControl(collapsed.Holds(row.Bead.Id), () => collapsed.Toggle(row.Bead.Id))
                    }
                    <RowTitle Class="board-title"
                              Address="@Href(row.Bead.Id)"
                              Tooltip="@row.Bead.Title"
                              Text="@row.Bead.Title" />
                    @if (row.Held > 0)
                    {
                        @Count(row.Held)
                    }
                </div>
                @if (row.Bead.IsClosed && row.Bead.CloseReason.Length > 0)
                {
                    <div class="text-muted board-close-reason">@row.Bead.CloseReason</div>
                }
            </td>
            <td class="board-cell-quiet"><BeadId Id="@row.Bead.Id" Quiet="false" /></td>
            <td class="board-cell-quiet">
                @if (row.Bead.Type.Length > 0)
                {
                    @FilterPress(row.Bead.Type, "type", string.Empty,
                                 filter.AfterAPressOnType(row.Bead.Type),
                                 "Filter the board by this type")
                }
            </td>
            <td class="board-cell-quiet">
                @if (row.Bead.HasPriority)
                {
                    @FilterPress($"p{row.Bead.PriorityText}", "priority", string.Empty,
                                 filter.AfterAPressOnPriority(row.Bead.PriorityText),
                                 "Filter the board by this priority")
                }
                else
                {
                    <text>—</text>
                }
            </td>
            <td>
                <div class="board-labels">
                    @foreach (var label in row.Bead.Labels)
                    {
                        @FilterPress(label, "label", "board-chip board-label",
                                     filter.AfterAPressOnLabel(label),
                                     "Filter the board by this label")
                    }
                </div>
            </td>
            <td>
                <span class="board-chip board-status board-status-@row.Status.Appearance"
                      title="@row.Status.Text">@row.Status.Text</span>
            </td>
            <td>
                @if (row.Bead.Prose.HasDemoLine)
                {
                    <span class="board-chip board-demo board-demo-yes" title="@row.Bead.Prose.DemoLine">demo</span>
                }
                else
                {
                    @FilterPress("no demo", "demo", "board-chip board-demo board-demo-no",
                                 filter.AfterAPressOnTheNoDemoLineMarker(),
                                 "This bead is not ready to implement. Filter the board by this marker.")
                }
            </td>
        </PressableRow>;

    // The control that collapses one row and opens it again. Only a row that holds a bead carries
    // it. Which way the chevron points is a question for the stylesheet, because the class that the
    // button carries already says whether the row is collapsed. The button states the same fact for
    // a screen reader, which reads no chevron.
    private RenderFragment CollapseControl(bool isCollapsed, Action toggle) =>
        @<button type="button" class="board-collapse @(isCollapsed ? "board-collapse-collapsed" : "")"
                 aria-expanded="@(!isCollapsed)"
                 aria-label="Collapse and expand the beads under this row"
                 title="Collapse and expand the beads under this row"
                 @onclick="toggle" @onclick:stopPropagation="true">
            <Icon Name="IconName.Chevron" />
        </button>;

    // The count of the beads under a row. An epic row carries the count of the beads below it, and
    // the Unparented row carries the count of the loose beads, so one drawing serves both.
    private RenderFragment Count(int held) =>
        @<span class="board-chip board-count" title="@HeldTitle(held)">@held</span>;

    private static string HeldTitle(int held) =>
        held == 1 ? "1 bead under this row" : $"{held} beads under this row";

    private RenderFragment BranchTick(IReadOnlyList<string> branch, string title) =>
        @<input class="form-check-input" type="checkbox"
                title="@title"
                checked="@selection.HoldsAll(branch)"
                @onchange="() => selection.ToggleAll(branch)" />;

    // One filter press: the type of a row, one of its labels, or the marker that says it states no
    // Demo line. It is a link, and its address carries the whole filter with the one part that the
    // press sets, so a second tab shows the same beads and the Back button undoes the press. The
    // press stops the row press, because it narrows the board and opens no bead.
    private RenderFragment FilterPress(string text, string kind, string shape, BoardFilter pressed, string title) =>
        @<a class="@($"board-filter-press board-filter-press-{kind} {shape}".TrimEnd())"
            href="@BoardFilterAddress.Of(pressed)"
            title="@title"
            @onclick:stopPropagation="true">@text</a>;

    private BacklogOutcome? outcome;
    private BoardFilter filter = BoardFilter.Everything;
    private TheBoard board = new([], []);
    private IReadOnlyList<string> types = [];
    private IReadOnlyList<long> priorities = [];
    private IReadOnlyList<string> labels = [];
    private IReadOnlyList<Bead> epics = [];
    private IReadOnlyList<SavedFilter> savedFilters = [];
    private readonly IdSet selection = new();
    private readonly CollapsedRows collapsed = new();
    private readonly NewTabFeedback newTab = new();
    private bool reading;
    private bool readAgain;

    protected override async Task OnInitializedAsync()
    {
        Backlogs.Changed += OnBacklogChanged;
        Selection.Changed += OnActiveProjectChanged;
        Navigation.LocationChanged += OnAddressChanged;
        filter = BoardFilterAddress.FilterIn(Navigation.Uri);
        if (Selection.Current is null)
        {
            return;
        }

        StartOn(Selection.Current);
        await Load();
    }

    // Draws the board that the new address asks for. The address carries the whole filter, so a
    // filter press, the Back button and an address that a person typed all reach the board the same
    // way, and the bead selection and the collapsed rows outlive every one of them.
    private void OnAddressChanged(object? sender, LocationChangedEventArgs changed)
    {
        _ = InvokeAsync(() =>
        {
            filter = BoardFilterAddress.FilterIn(changed.Location);
            Rebuild();
            StateHasChanged();
        });
    }

    // Draws the board of another project after the top bar switches it. The board drops the filter
    // and the bead selection of the old project, because an epic id and a label of that project
    // name nothing in this one.
    private void OnActiveProjectChanged(ActiveProjectChange change)
    {
        _ = InvokeAsync(async () =>
        {
            filter = BoardFilter.Everything;
            Navigation.NavigateTo(BoardFilterAddress.Page);
            selection.Clear();
            collapsed.Clear();
            outcome = null;
            StartOn(change.Project);
            StateHasChanged();
            await RereadOrSayWhyNot();
        });
    }

    private void StartOn(ProjectPath project)
    {
        savedFilters = SavedFilters.Filters(project);
        Watchers.Watch(project);
    }

    // Reads the beads again when something invalidated the backlog of the active project, whether
    // that was an agent in a terminal or a write of this app.
    private void OnBacklogChanged(ProjectPath project)
    {
        if (Selection.Current is null || !Selection.Current.Equals(project))
        {
            return;
        }

        _ = InvokeAsync(RereadOrSayWhyNot);
    }

    // Reads the backlog again. Nothing waits for this read, because a change arrives on its own, so
    // a read that throws puts its reason on the board instead of vanishing.
    private async Task RereadOrSayWhyNot()
    {
        try
        {
            await Reread();
        }
        catch (Exception unread)
        {
            outcome = BacklogOutcome.Failure(
                $"The app could not read the beads of this project again. {unread.Message}");
            StateHasChanged();
        }
    }

    // Reads the backlog again and draws the board. A read that arrives while another one runs waits
    // for it and then reads once, so a bulk action costs the board two reads and not one for each
    // bead of the selection.
    private async Task Reread()
    {
        if (reading)
        {
            readAgain = true;
            return;
        }

        reading = true;
        try
        {
            do
            {
                readAgain = false;
                await Load();
                StateHasChanged();
            }
            while (readAgain);
        }
        finally
        {
            reading = false;
        }
    }

    public void Dispose()
    {
        Backlogs.Changed -= OnBacklogChanged;
        Selection.Changed -= OnActiveProjectChanged;
        Navigation.LocationChanged -= OnAddressChanged;
    }

    private async Task Load()
    {
        if (Selection.Current is null)
        {
            return;
        }

        outcome = await Backlogs.ReadAsync(Selection.Current);
        types = outcome.Backlog.Types;
        priorities = outcome.Backlog.Priorities;
        labels = outcome.Backlog.Labels;
        epics = outcome.Backlog.Epics;
        Rebuild();
    }

    // Takes the board to the address of the filter that the bar now states, because the address is
    // where the filter lives. A change of the search text replaces the address instead of adding to
    // the history, so the Back button leaves the search and never walks back one letter at a time.
    private void OnFilterChanged(BoardFilter changed)
    {
        var onlyTheTextChanged = (changed with { Text = filter.Text }) == filter;
        Navigation.NavigateTo(BoardFilterAddress.Of(changed), forceLoad: false, replace: onlyTheTextChanged);
    }

    private void SaveTheFilter(string name)
    {
        if (Selection.Current is null)
        {
            return;
        }

        SavedFilters.Save(Selection.Current, name, filter);
        savedFilters = SavedFilters.Filters(Selection.Current);
    }

    private void Forget(SavedFilter saved)
    {
        if (Selection.Current is null)
        {
            return;
        }

        SavedFilters.Remove(Selection.Current, saved.Name);
        savedFilters = SavedFilters.Filters(Selection.Current);
    }

    private void Rebuild()
    {
        if (outcome is not null)
        {
            board = outcome.Backlog.ToBoard(filter);
        }

        selection.KeepOnly(OnTheBoard.Select(bead => bead.Id));
    }

    private IReadOnlyList<string> UnparentedIds => [.. board.Unparented.Select(row => row.Bead.Id)];

    private IEnumerable<Bead> OnTheBoard => board.EveryRow.Select(row => row.Bead);

    private IReadOnlyList<Bead> SelectedBeads => [.. OnTheBoard.Where(bead => selection.Holds(bead.Id))];

    private void ToggleTheBead(string id) => selection.Toggle(id);

    private void ClearTheSelection() => selection.Clear();

    private void KeepOnlyTheseBeads(IReadOnlyList<string> ids) => selection.KeepOnly(ids);

    // Opens the bead that a press on a row asks for, where the release asks for it. The board
    // stays as it is when the bead opens beside it, and it says so when the browser refuses.
    private async Task Open(string id, MouseEventArgs release) =>
        newTab.Take(await Opener.OpenAsync(Href(id), release));

    private static string Href(string id) => BeadPageAddress.Of(id);
}
