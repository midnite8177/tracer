@using TracerUi.Core.Beads
@using TracerUi.Core.Boards
@using TracerUi.Core.Projects
@inherits CapabilityAware
@inject BulkWriter Bulk

@if (Count > 0 || plan is not null)
{
<div class="board-bulk-bar">
    @if (Count > 0)
    {
    @if (!Probed)
    {
        <ProbePending />
    }
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <strong>@Count selected</strong>
        </div>

        <div class="col-auto">
            <label class="form-label" for="bulk-category">Action</label>
            <select class="form-select form-select-sm" id="bulk-category" title="@Why(Category.Write)"
                    @bind="categoryName" @bind:after="Restart">
                @foreach (var offered in BulkCategory.All)
                {
                    <option value="@offered.Name">@offered.Name</option>
                }
            </select>
        </div>

        @if (Category.Verbs.Count > 1)
        {
            <div class="col-auto">
                <label class="form-label" for="bulk-verb">Add or remove</label>
                <select class="form-select form-select-sm" id="bulk-verb" @bind="verb">
                    @foreach (var offered in Category.Verbs)
                    {
                        <option value="@offered">@BulkVerbs.Of(offered).Name</option>
                    }
                </select>
            </div>
        }

        @if (Category.Needs == BulkValue.ALabel)
        {
            <div class="col-auto">
                <label class="form-label" for="bulk-label">Label</label>
                <input class="form-control form-control-sm" id="bulk-label" list="bulk-labels"
                       placeholder="A label" @bind="value" @bind:event="oninput" />
                <datalist id="bulk-labels">
                    @foreach (var label in Labels)
                    {
                        <option value="@label"></option>
                    }
                </datalist>
            </div>
        }
        else if (Category.Needs == BulkValue.AReason)
        {
            <div class="col">
                <label class="form-label" for="bulk-reason">The shared reason</label>
                <input class="form-control form-control-sm" id="bulk-reason"
                       placeholder="Why the work ended" @bind="value" @bind:event="oninput" />
            </div>
        }
        else if (Category.Needs == BulkValue.AnEpic)
        {
            <div class="col-auto">
                <label class="form-label" for="bulk-epic">Epic</label>
                <EpicPicker Id="bulk-epic" Epics="Epics" @bind-Value="value" />
            </div>
        }
        else if (Category.Needs == BulkValue.APriority)
        {
            <div class="col-auto">
                <label class="form-label" for="bulk-priority">Priority</label>
                <select class="form-select form-select-sm" id="bulk-priority" @bind="value">
                    <option value="">Pick a priority</option>
                    @foreach (var priority in BeadWriteChoices.Priorities)
                    {
                        <option value="@priority">p@(priority)</option>
                    }
                </select>
            </div>
        }
        else if (Category.Needs == BulkValue.AType)
        {
            <div class="col-auto">
                <label class="form-label" for="bulk-type">Type</label>
                <select class="form-select form-select-sm" id="bulk-type" @bind="value">
                    <option value="">Pick a type</option>
                    @foreach (var type in BeadWriteChoices.Types)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
        }

        <div class="col-auto">
            <button id="bulk-review" class="btn btn-sm btn-primary" disabled="@(!Can(Category.Write))" @onclick="Review">Review</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearTheSelection">
                Clear the selection
            </button>
        </div>
    </div>

    @if (!Can(Category.Write))
    {
        <p class="text-danger board-bulk-message">@Why(Category.Write)</p>
    }
    }

    @if (plan is not null)
    {
        <div class="mt-2 board-bulk-plan">
            <p class="board-bulk-summary"><strong>@plan.Summary</strong></p>

            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        @if (plan.Action.Verb == BulkVerb.CloseWithAReason)
                        {
                            <th>The reason this bead closes with</th>
                        }
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var step in plan.Steps)
                    {
                        <tr class="board-bulk-row board-bulk-row-@RowWord(step.BeadId)">
                            <td><BeadId Id="@step.BeadId" Quiet="false" /></td>
                            <td>@step.Title</td>
                            @if (plan.Action.Verb == BulkVerb.CloseWithAReason)
                            {
                                <td>
                                    <input class="form-control form-control-sm"
                                           value="@step.Reason"
                                           disabled="@(committing || Ended)"
                                           @onchange="changed => SetTheReason(step.BeadId, changed)" />
                                </td>
                            }
                            <td class="board-bulk-row-state">
                                <span class="board-bulk-row-word">@RowWord(step.BeadId)</span>
                                <WorkingMark Writing="@(RowState(step.BeadId).State == BulkRowState.Writing)" Immediate="true" />
                                @if (RowState(step.BeadId).State == BulkRowState.Failed)
                                {
                                    <span class="board-bulk-row-message">@RowState(step.BeadId).Message</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Ended && !plan.IsReady)
            {
                <p class="text-danger board-bulk-message">@plan.Problem</p>
            }

            @if (!Ended)
            {
                <button id="bulk-commit" class="btn btn-sm btn-danger" disabled="@(!plan.IsReady || committing)"
                        aria-busy="@CommittingAriaBusy"
                        @onclick="Commit">Commit this action</button>
                <button id="bulk-cancel" class="btn btn-sm btn-outline-secondary" disabled="@committing"
                        @onclick="Cancel">Cancel</button>
            }
            else
            {
                <p class="@(report!.Whole ? "text-success" : "text-danger") board-bulk-message">@report.Summary</p>
                @if (report.Failures.Count > 0)
                {
                    <button id="bulk-retry" class="btn btn-sm btn-outline-danger" @onclick="SelectTheFailures">
                        Select the beads that failed
                    </button>
                }
                <button id="bulk-close" class="btn btn-sm btn-outline-secondary" @onclick="Close">Close</button>
            }
        </div>
    }
</div>
}

@code {
    /// <summary>The project that holds every bead of the selection.</summary>
    [Parameter]
    [EditorRequired]
    public required ProjectPath Project { get; set; }

    /// <summary>The beads that the person picked, as the board orders them.</summary>
    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<Bead> Selected { get; set; }

    /// <summary>The labels of this backlog, so that the label control offers what already exists.</summary>
    [Parameter]
    public IReadOnlyList<string> Labels { get; set; } = [];

    /// <summary>The epics of this backlog, so that a move offers them by title.</summary>
    [Parameter]
    public IReadOnlyList<Bead> Epics { get; set; } = [];

    /// <summary>Empties the selection.</summary>
    [Parameter]
    public EventCallback OnCleared { get; set; }

    /// <summary>Keeps only the beads that a commit failed on, so that the person retries those.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> OnRetry { get; set; }

    private string categoryName = BulkCategory.Label.Name;
    private BulkVerb verb = BulkVerb.AddALabel;
    private string value = string.Empty;
    private BulkPlan? plan;
    private BulkReport? report;
    private bool committing;
    private readonly Dictionary<string, BulkRowStatus> rowStates = new(StringComparer.Ordinal);

    private int Count => Selected.Count;

    // aria-busy takes a string state, not a bool attribute, as CapabilityAware.AriaBusy does for a
    // single write; a bulk commit runs no single write, so it carries the same rule on its own flag.
    private string CommittingAriaBusy => committing ? "true" : "false";

    private BulkCategory Category => BulkCategory.Named(categoryName);

    private bool Ended => report is not null;

    protected override ProjectPath OfProject => Project;

    // Drops a plan that the selection outgrew. The row checkboxes stay live while a plan stands, so
    // a plan that no longer names the beads of the selection would act on the wrong beads. A plan
    // that already ended is exempt: its own run is what changes the selection, by taking a written
    // bead out of the board's own filter, and the table must survive exactly that read.
    protected override void OnParametersSet()
    {
        if (!Ended && plan is not null
            && !plan.Steps.Select(step => step.BeadId).SequenceEqual(Selected.Select(bead => bead.Id)))
        {
            Forget();
        }
    }

    private void Restart()
    {
        verb = Category.Verbs[0];
        value = string.Empty;
        Forget();
    }

    private void Review()
    {
        plan = BulkPlan.For(new BulkAction(verb, value), Selected);
        report = null;
        rowStates.Clear();
        foreach (var step in plan.Steps)
        {
            rowStates[step.BeadId] = BulkRowStatus.Waiting;
        }
    }

    private void SetTheReason(string beadId, ChangeEventArgs changed) =>
        plan = plan?.WithReasonFor(beadId, changed.Value?.ToString() ?? string.Empty);

    private void Cancel() => Forget();

    private void Close() => Forget();

    private void Forget()
    {
        plan = null;
        report = null;
        rowStates.Clear();
    }

    private async Task Commit()
    {
        if (plan is null)
        {
            return;
        }

        committing = true;
        report = await Bulk.RunAsync(Project, plan, ReportRow);
        committing = false;
    }

    private void ReportRow(string beadId, BulkRowStatus status)
    {
        rowStates[beadId] = status;
        StateHasChanged();
    }

    private BulkRowStatus RowState(string beadId) =>
        rowStates.TryGetValue(beadId, out var status) ? status : BulkRowStatus.Waiting;

    private string RowWord(string beadId) => Word(RowState(beadId).State);

    private static string Word(BulkRowState state) => state switch
    {
        BulkRowState.Waiting => "waiting",
        BulkRowState.Writing => "writing",
        BulkRowState.Written => "written",
        BulkRowState.Failed => "failed",
        var other => throw new ArgumentOutOfRangeException(nameof(state), other, "not a row state this bar knows"),
    };

    private async Task SelectTheFailures()
    {
        if (report is not null)
        {
            await OnRetry.InvokeAsync(report.FailedIds);
        }
    }

    private async Task ClearTheSelection()
    {
        Restart();
        await OnCleared.InvokeAsync();
    }
}
