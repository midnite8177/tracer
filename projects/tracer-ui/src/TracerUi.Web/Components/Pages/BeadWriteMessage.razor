@if (Message is { } message)
{
    <p class="@(Wrote ? "text-success" : "text-danger") bead-write-message">@message</p>
}

@code {
    /// <summary>What the last write said, or null when none has run.</summary>
    [Parameter]
    [EditorRequired]
    public required string? Message { get; set; }

    /// <summary>True when that write succeeded, because good news and bad news read differently.</summary>
    [Parameter]
    [EditorRequired]
    public required bool Wrote { get; set; }
}
