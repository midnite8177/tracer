root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,csproj,slnx,props,targets}]
indent_size = 2

[*.md]
indent_size = 2

[*.png]
charset = unset
insert_final_newline = unset

# Vendored third-party code keeps the shape that its publisher shipped.
[**/wwwroot/lib/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
